{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-fornecedores": {
      "root": "api-fornecedores",
      "framework": "express",
      "buildCommand": "npx --no-install prisma generate"
    },
    "web-fornecedores": {
      "root": "web-fornecedores",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": { "service": "api-fornecedores" }
    },
    {
      "source": "/health",
      "destination": { "service": "api-fornecedores" }
    },
    {
      "source": "/:path*",
      "destination": { "service": "web-fornecedores" }
    }
  ]
}
